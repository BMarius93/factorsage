# Local development defaults only. Never commit real secrets.

NODE_ENV=development
# Use debug locally for operational detail; production should normally use info.
LOG_LEVEL=debug

POSTGRES_DB=intrinsic_value
POSTGRES_USER=intrinsic
POSTGRES_PASSWORD=intrinsic_dev_password
POSTGRES_PORT=5432

DATABASE_URL=postgresql://intrinsic:intrinsic_dev_password@localhost:5432/intrinsic_value

# Dedicated database for every PostgreSQL-backed test suite. Required by `pnpm test`;
# tests never fall back to DATABASE_URL. Create it once and migrate it with
# `pnpm db:test:prepare`.
# TEST_DATABASE_URL=postgresql://intrinsic:intrinsic_dev_password@localhost:5432/intrinsic_value_test

REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# The Backtest V1 QA validation matrix (1,000 runs) executes in its own database, never the
# development one — which holds the hydrated history it copies from and must not be reset — and
# never the ordinary test one, whose execution calendar is deliberately short and would silently
# clip a thirty-year run to whatever it happens to cover. The name must contain "matrix", the host
# must be local (or QA_MATRIX_ALLOW_REMOTE_HOST=true), and NODE_ENV must not be production.
# Create and populate it once with `pnpm qa:matrix:provision`.
# QA_MATRIX_DATABASE_URL=postgresql://intrinsic:intrinsic_dev_password@localhost:5432/intrinsic_value_matrix
# Where canonical market data is copied from during provisioning. Read-only; defaults to
# DATABASE_URL, which is where the 34-year price retention work already hydrated it.
# QA_MATRIX_SOURCE_DATABASE_URL=
# Matrix Redis, isolated by logical database index so matrix execution cannot share cached
# projections, hydration locks or the FMP gate with the development stack. Derived from REDIS_URL
# with this index when QA_MATRIX_REDIS_URL is unset.
QA_MATRIX_REDIS_DB=3
# QA_MATRIX_REDIS_URL=redis://localhost:6379/3
# Backtests executed at once, i.e. BACKTEST_WORKER_PROCESSES for the matrix worker pool. Defaults
# to half the cores, capped at 4 and by roughly one process per 2 GB of RAM.
# QA_MATRIX_CONCURRENCY=
# Pins the matrix clock so one sweep is reproducible from a single value. Unset seeds and runs the
# matrix that is valid today.
# QA_MATRIX_AS_OF_DATE=
STOCK_CACHE_MAX_RESIDENT_STOCKS=100
STOCK_DETAILS_HISTORY_DAYS=365
# The PRODUCT horizon: the oldest day a user may select, chart, query or backtest.
# Raw daily prices are retained four years further back, derived from the catalog's longest
# series so a 200-week average is already valid on the first visible day. That warm-up is
# internal and is never configured here — see docs/decisions/price-retention-warmup-horizon.md.
STOCK_HISTORY_YEARS=30
STOCK_RECENT_PRICE_FRESHNESS_MS=21600000
STOCK_FUNDAMENTALS_FRESHNESS_MS=21600000
STOCK_RECENT_TAIL_CALENDAR_DAYS=10
STOCK_DATA_LOAD_LOCK_MS=30000
STOCK_DATA_LOCK_WAIT_MS=120000

WEB_PORT=3000
API_PORT=3001
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000

# Development placeholder only. Use a unique, randomly generated value in deployments.
AUTH_JWT_SECRET=development-only-replace-with-a-random-secret-at-least-32-characters
AUTH_TOKEN_TTL_SECONDS=28800
AUTH_COOKIE_NAME=intrinsic_auth
# How long an email-verification link stays redeemable. Tokens are single-use.
AUTH_EMAIL_VERIFICATION_TTL_SECONDS=86400
# How long a password-reset link stays redeemable. Tokens are single-use and requesting a new
# link invalidates the previous one. Deliberately much shorter than the verification TTL: a reset
# link is a live credential for an account that already exists.
AUTH_PASSWORD_RESET_TTL_SECONDS=3600

# Absolute base URL of the web application. The API builds verification links and post-OAuth
# redirects against this value instead of trusting a request Host header.
WEB_BASE_URL=http://localhost:3000

# Google sign-in. Optional and disabled here: all three must be set together, and a partially
# configured provider is rejected at startup rather than silently disabled. Set all three to
# enable it; the local callback is normally
# http://localhost:3001/auth/google/callback
# and must match the redirect URI registered in the Google Cloud console.
# Never commit real credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# Outbound email. Optional and disabled here: with every SMTP_* variable empty the API runs
# without a mail transport and registration reports the verification email as undeliverable.
# Setting any one of them turns the transport on, after which SMTP_HOST and SMTP_FROM are
# required and SMTP_USER/SMTP_PASSWORD are all or nothing, so a local unauthenticated relay
# stays valid. SMTP_PORT defaults to 587 when left empty, and SMTP_SECURE defaults to true on
# port 465 and false otherwise.
# Local development works well against a catch-all relay such as Mailpit (SMTP_HOST=localhost,
# SMTP_PORT=1025, no credentials).
# Never commit real credentials.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Required only while running `pnpm db:seed`. Never commit real credentials.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Persistent QA personas for Playwright and live API smoke testing, created by
# `pnpm test:users:seed`. Both passwords must be at least 12 characters and satisfy the
# registration policy. Never commit real credentials. See ai/workflows/auth-testing.md.
# Test personas. One account per commercial plan, so entitlement behaviour is tested by signing in
# as a plan rather than by mutating one user between them. `ai/workflows/auth-testing.md` documents
# which persona to use when; `PRO_USER` (QA_USER_*) is the normal development account.
# Every password must be at least 12 characters, the product's own registration policy.
# PRO_USER — the default local development and manual-testing account.
QA_USER_EMAIL=
QA_USER_PASSWORD=
# ADMIN_USER — internal/QA only. Seeded plan=FREE, role=ADMIN.
QA_ADMIN_EMAIL=
QA_ADMIN_PASSWORD=
# FREE_USER — the smallest capacity; the entitlement boundary cases.
QA_FREE_EMAIL=
QA_FREE_PASSWORD=
# STARTER_USER — the middle tier.
QA_STARTER_EMAIL=
QA_STARTER_PASSWORD=
# DOWNGRADED_USER — FREE, holding content created under a higher tier.
QA_DOWNGRADED_EMAIL=
QA_DOWNGRADED_PASSWORD=

# Base URL of the already-running stack Playwright drives. Defaults to http://localhost:3000.
E2E_BASE_URL=http://localhost:3000

# Required for live stock-data misses. Deterministic tests do not require it.
FMP_API_KEY=
FMP_TIMEOUT_MS=15000
FMP_MAX_RETRIES=3
FMP_RETRY_BASE_DELAY_MS=500
# Backoff cap when FMP does not provide Retry-After.
FMP_RETRY_MAX_DELAY_MS=30000
# Cumulative retry-sleep budget for this caller; shared cooldown is not capped.
FMP_MAX_RETRY_WAIT_MS=30000
FMP_MAX_CONCURRENT_REQUESTS=4
FMP_RATE_LIMIT_PER_WINDOW=20
FMP_RATE_WINDOW_MS=1000
FMP_MAX_QUEUE_DEPTH=100
FMP_MAX_QUEUE_WAIT_MS=30000

# Backtest worker. The supervisor forks BACKTEST_WORKER_PROCESSES children (1..32) and each child
# executes at most one backtest at a time: one simulation is never split across cores, so these
# processes add throughput across independent runs, not speed on a single run. Set it to 1 to run
# a single worker.
BACKTEST_WORKER_PROCESSES=2
# How long a child waits before asking for work again when the queue is empty.
BACKTEST_JOB_POLL_INTERVAL_MS=1000
# A claim is held only while its lease is renewed; an expired lease is reclaimable, which is what
# makes a crashed worker self-healing. Keep the heartbeat well under the lease.
BACKTEST_JOB_LEASE_MS=60000
BACKTEST_JOB_HEARTBEAT_INTERVAL_MS=15000
# Attempts a job may consume before it is failed terminally, and how long a recovered or retried
# job waits before it becomes claimable again.
BACKTEST_JOB_MAX_ATTEMPTS=3
BACKTEST_JOB_RETRY_BACKOFF_MS=15000
# Live-progress cadence. Checkpoints are observation only and never read back into simulated
# state, so changing them cannot change a result. The minimum interval keeps a fast run from
# writing a progress row per millisecond.
BACKTEST_CHECKPOINT_EVERY_DAYS=5
BACKTEST_CHECKPOINT_MIN_INTERVAL_MS=1000
# How many securities are projected into evaluation frames at once while preparing a run. Each one
# may hydrate from the provider, so this shares the same budget as every other FMP caller.
BACKTEST_FRAME_LOAD_CONCURRENCY=4

# Monitor worker. The supervisor forks MONITOR_WORKER_PROCESSES children (0..8). A Monitor
# evaluation cycle is a singleton durable claim, so extra children buy availability — another one
# picks scanning up when the first dies — never throughput. Set it to 0 to disable monitoring in
# this process entirely.
MONITOR_WORKER_PROCESSES=1
# Gap between the END of one evaluation cycle and the earliest start of the next, so a slow cycle
# delays the next one instead of overlapping with it. This is the monitoring cadence, and it is an
# application decision: it is deliberately not exposed to users anywhere in the product.
MONITOR_SCAN_INTERVAL_MS=300000
# How long a child waits before asking whether a cycle is due again.
MONITOR_SCAN_POLL_INTERVAL_MS=5000
# A claimed cycle is held only while its lease is renewed; an expired lease is reclaimable, which
# is what keeps scanning alive after a crash. Keep the heartbeat well under the lease.
MONITOR_SCAN_LEASE_MS=120000
MONITOR_SCAN_HEARTBEAT_INTERVAL_MS=30000
# How long a failed cycle waits before it becomes claimable again.
MONITOR_SCAN_RETRY_BACKOFF_MS=60000
# How many symbols are prepared into evaluation snapshots at once. Each one may hydrate from the
# provider, so this shares the same budget as every other FMP caller.
MONITOR_SYMBOL_CONCURRENCY=4
# How stale a provider quote may be and still act as the provisional current-day observation.
# Beyond it the symbol is NOT_EVALUABLE for that cycle, which leaves every durable match exactly as
# it was — a stale quote presented as the current observation would be a fabricated bar. The default
# spans a long weekend plus a public holiday.
MONITOR_QUOTE_MAX_AGE_MS=345600000

# Forensic debug archives — local development only, off by default. `full` makes each worker write
# one self-contained .zip per backtest attempt holding the raw replay evidence for that run: the
# immutable snapshot, the execution calendar, the benchmark input, the evaluation frames the
# simulation actually consumed, the trades, the equity and the result. It is observational and
# never changes what a run computes. Asking for it with NODE_ENV=production is a startup error.
# See docs/development/backtest-debug-archive.md.
BACKTEST_DEBUG_ARCHIVE=off
# Where those archives land. Relative paths resolve against the repository root, and the default
# is git-ignored.
BACKTEST_DEBUG_ARCHIVE_DIR=.debug/backtests

# ---------------------------------------------------------------------------
# Stripe Billing V1 — server-only. See ai/architecture/billing.md.
# ---------------------------------------------------------------------------
# Billing is optional as a whole and all-or-nothing once touched: with every STRIPE_* variable
# empty the API registers no Stripe client, `GET /billing/status` reports billing as unavailable,
# and nothing else in the workspace needs a Stripe secret. Setting any one of them turns billing
# on, after which all six required values must be present and well-formed.
#
# SANDBOX ONLY in development. A live-mode key (sk_live_/rk_live_) outside NODE_ENV=production is
# refused at startup, and a sandbox key in production is refused too, so local testing can never
# move real money. Never commit real values.
#
# Local setup, in order:
#   1. stripe login                       (sandbox account)
#   2. pnpm billing:verify-catalog        (checks the four prices against Stripe)
#   3. stripe listen --forward-to localhost:3001/webhooks/stripe
#      Paste the whsec_... it prints into STRIPE_WEBHOOK_SECRET below.
STRIPE_SECRET_KEY=
# Signing secret for the endpoint receiving events. `stripe listen` prints a local one; a deployed
# endpoint has its own in the Stripe Dashboard. They are different values — do not share one.
STRIPE_WEBHOOK_SECRET=
# The four recurring prices, per Stripe environment. Sandbox and live IDs are never interchangeable.
# Each must be a distinct price_... ID; two keys pointing at one price is refused at startup.
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
# Where Stripe returns the browser. Server-configured, never taken from a request. Defaults are
# derived from WEB_BASE_URL, so a local setup needs none of these.
# STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:3000/billing?checkout=success
# STRIPE_CHECKOUT_CANCEL_URL=http://localhost:3000/billing?checkout=cancelled
# STRIPE_PORTAL_RETURN_URL=http://localhost:3000/billing
# One Stripe API call's network timeout, and how many times the SDK retries a call Stripe marks
# safely retryable. Both must be positive integers.
STRIPE_TIMEOUT_MS=20000
STRIPE_MAX_NETWORK_RETRIES=2

# Opt-in Stripe sandbox smoke suite (`pnpm test:billing:sandbox`). Excluded from `pnpm test`, and
# it refuses to run without this flag, so ordinary CI never reaches the Stripe network.
# STRIPE_SANDBOX_SMOKE=false

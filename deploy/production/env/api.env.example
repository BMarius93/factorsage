# /etc/factorsage/api.env — the HTTP API. Every value here is read at process start.
NODE_ENV=production
LOG_LEVEL=info
# Prisma's pool per process. Sized in postgresql.conf's connection budget.
DATABASE_URL=postgresql://factorsage:<POSTGRES_PASSWORD>@postgres:5432/factorsage?connection_limit=20&pool_timeout=10
REDIS_URL=redis://:<REDIS_PASSWORD>@redis:6379/0
WEB_BASE_URL=https://app.factorsage.example
CORS_ORIGINS=https://app.factorsage.example
AUTH_JWT_SECRET=<generate: openssl rand -base64 48>
AUTH_TOKEN_TTL_SECONDS=604800
# Provider and payments. Keys are runtime secrets, never build arguments.
FMP_API_KEY=<FMP key>
STRIPE_SECRET_KEY=<sk_live_…>
STRIPE_WEBHOOK_SECRET=<whsec_…>
# The six sellable prices: $19 / $169, $49 / $439, $199 / $1,790 (a year is charged upfront).
# The *_YEARLY names held the V1 $99 / $299 years — set them to the V2 yearly ids, and check all six
# with verify-catalog before deploying (RUNBOOK.md §4).
STRIPE_PRICE_STARTER_MONTHLY=<price_…>
STRIPE_PRICE_STARTER_YEARLY=<price_…>
STRIPE_PRICE_PRO_MONTHLY=<price_…>
STRIPE_PRICE_PRO_YEARLY=<price_…>
STRIPE_PRICE_PRO_PLUS_MONTHLY=<price_…>
STRIPE_PRICE_PRO_PLUS_YEARLY=<price_…>
# Retired V1 prices that live subscriptions are still billed on (grandfathered; never sold).
# List every one before switching to the V2 price ids, or those subscribers fall to Free. A price
# listed here and in a STRIPE_PRICE_* variable is refused at startup.
STRIPE_LEGACY_PRICES=<price_…=STARTER/MONTH,price_…=PRO/YEAR,…>
# Transactional email.
SMTP_HOST=<smtp host>
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<smtp user>
SMTP_PASSWORD=<smtp password>
SMTP_FROM=FactorSage <noreply@factorsage.example>
# Optional: Google sign-in. All three or none — the API refuses to start with only some of them.
# GOOGLE_CLIENT_ID=<client id>
# GOOGLE_CLIENT_SECRET=<client secret>
# GOOGLE_CALLBACK_URL=https://api.factorsage.example/auth/google/callback

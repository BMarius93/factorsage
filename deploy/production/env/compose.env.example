# /etc/factorsage/compose.env — values docker compose interpolates into docker-compose.yml.
# Not secret, but host-specific. Copy, fill in, chmod 0600, chown root.
APP_DOMAIN=app.factorsage.example
API_DOMAIN=api.factorsage.example
ACME_EMAIL=ops@factorsage.example
REGISTRY=ghcr.io/your-org/factorsage
RELEASE=2026-10-23-abc1234
BACKUP_DIR=/var/backups/factorsage

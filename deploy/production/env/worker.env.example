# /etc/factorsage/worker.env — the worker supervisor and its children (backtest x4, Monitor,
# market data, stock EOD). Every child inherits this environment. The worker holds no payment,
# email or session secret: it reads none.
NODE_ENV=production
LOG_LEVEL=info
# One pool per child process: seven children x 6 connections (see postgresql.conf).
DATABASE_URL=postgresql://factorsage:<POSTGRES_PASSWORD>@postgres:5432/factorsage?connection_limit=6&pool_timeout=30
REDIS_URL=redis://:<REDIS_PASSWORD>@redis:6379/0
FMP_API_KEY=<FMP key>
# Provider traffic, shared by every process through the Redis gate. Set to the FMP plan's
# documented limit, below it rather than at it (docs/production/capacity-model.md, "FMP").
FMP_MAX_CONCURRENT_REQUESTS=4
FMP_RATE_LIMIT_PER_WINDOW=20
FMP_RATE_WINDOW_MS=1000

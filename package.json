{
  "name": "intrinsic-value",
  "private": true,
  "engines": {
    "node": "22.23.2"
  },
  "scripts": {
    "dev:web": "pnpm --filter @intrinsic/web dev",
    "dev:api": "pnpm --filter @intrinsic/config build && pnpm --filter @intrinsic/contracts build && pnpm --filter @intrinsic/domain build && pnpm --filter @intrinsic/database build && pnpm --filter @intrinsic/fmp build && pnpm --filter @intrinsic/observability build && pnpm --filter @intrinsic/stock-data build && pnpm --filter @intrinsic/api start:dev",
    "dev:worker": "pnpm --filter @intrinsic/config build && pnpm --filter @intrinsic/observability build && pnpm --filter @intrinsic/worker dev",
    "build": "pnpm -r --if-present build",
    "build:packages": "pnpm -r --filter './packages/**' --if-present build",
    "pretypecheck": "pnpm build:packages",
    "typecheck": "pnpm -r --if-present typecheck",
    "pretest": "pnpm build:packages",
    "test": "pnpm -r --if-present test",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "infra:up": "docker compose up -d postgres redis",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f postgres redis",
    "stack:up": "docker compose --profile app up --build",
    "stack:down": "docker compose --profile app down",
    "db:generate": "pnpm --filter @intrinsic/database prisma:generate",
    "db:validate": "pnpm --filter @intrinsic/database prisma:validate",
    "db:migrate:dev": "pnpm --filter @intrinsic/database prisma:migrate:dev",
    "db:migrate:deploy": "pnpm --filter @intrinsic/database prisma:migrate:deploy",
    "db:status": "pnpm --filter @intrinsic/database prisma:migrate:status",
    "db:pull": "pnpm --filter @intrinsic/database prisma:db:pull",
    "db:studio": "pnpm --filter @intrinsic/database prisma:studio",
    "db:seed": "pnpm --filter @intrinsic/config build && pnpm --filter @intrinsic/database build && pnpm --filter @intrinsic/api seed:admin"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0",
    "typescript-eslint": "^8.0.0"
  }
}

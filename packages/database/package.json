{
  "name": "@intrinsic/database",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "node ./scripts/prisma-command.mjs generate",
    "prisma:validate": "node ./scripts/prisma-command.mjs validate",
    "prisma:migrate:dev": "node ./scripts/prisma-command.mjs migrate dev",
    "prisma:migrate:deploy": "node ./scripts/prisma-command.mjs migrate deploy",
    "prisma:migrate:status": "node ./scripts/prisma-command.mjs migrate status",
    "prisma:db:pull": "node ./scripts/prisma-command.mjs db pull",
    "prisma:studio": "node ./scripts/prisma-command.mjs studio"
  },
  "dependencies": {
    "@prisma/client": "6.19.2"
  },
  "devDependencies": {
    "prisma": "6.19.2",
    "typescript": "^5.9.0"
  }
}

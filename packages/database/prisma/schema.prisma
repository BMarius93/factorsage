generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum OAuthProvider {
  GOOGLE
}

enum SecurityType {
  STOCK
  ETF
  FUND
}

enum StockDataset {
  SECURITY_PROFILE
  DAILY_PRICE
  WEEKLY_PRICE
  DAILY_DERIVED_STATE
  INCOME_STATEMENT
  BALANCE_SHEET
  CASH_FLOW
  DIVIDEND
  STOCK_SPLIT
}

enum FinancialStatementType {
  INCOME
  BALANCE_SHEET
  CASH_FLOW
}

enum FinancialPeriod {
  FY
  Q1
  Q2
  Q3
  Q4
}

/// Buy eligibility of one security inside one list. `FULL` means eligible for the whole period a
/// future strategy/backtest covers and must persist zero buy-window rows; `CUSTOM` restricts BUYs
/// to the item's normalized buy-window ranges and requires at least one row.
enum BuyWindowMode {
  FULL
  CUSTOM
}

/// Product identity. `passwordHash` is null for external-identity-only users and
/// `emailVerifiedAt` is null until a local registration proves the address.
model User {
  id                 String                   @id @default(uuid())
  email              String                   @unique
  passwordHash       String?
  emailVerifiedAt    DateTime?
  role               UserRole                 @default(USER)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  oauthAccounts      OAuthAccount[]
  verificationTokens EmailVerificationToken[]
  stockLists         StockList[]
  strategies         Strategy[]
  backtestRuns       BacktestRun[]
  monitors           Monitor[]
}

/// External identity linked to a product `User`. FactorSage uses external providers for
/// identity only, so provider access/refresh tokens are deliberately never persisted.
model OAuthAccount {
  id                String        @id @default(uuid())
  userId            String
  provider          OAuthProvider
  providerAccountId String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// Single-use email-verification token. Only the hash is stored, and a user has at most one
/// outstanding token so a resend rotates and invalidates the previous one.
model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String   @unique
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Security {
  id                  String                 @id @default(uuid())
  providerSymbol      String                 @unique
  symbol              String
  name                String
  exchangeCode        String
  exchangeName        String?
  currency            String
  cik                 String?
  isin                String?
  cusip               String?
  country             String?
  sector              String?
  industry            String?
  ipoDate             DateTime?              @db.Date
  type                SecurityType
  isAdr               Boolean
  isActivelyTrading   Boolean
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  profile             SecurityProfile?
  datasetStates       StockDatasetState[]
  datasetCoverage     StockDatasetCoverage[]
  dailyPrices         DailyPrice[]
  weeklyPrices        WeeklyPrice[]
  dailyDerivedState   DailyDerivedState[]
  financialStatements FinancialStatement[]
  stockListItems      StockListItem[]
  backtestTrades      BacktestTrade[]
  backtestPositions   BacktestPosition[]
  monitorSignalStates MonitorSignalState[]
  monitorSignals      MonitorSignal[]

  @@unique([symbol, exchangeCode])
  @@index([symbol])
}

/// User-owned reusable stock universe. Mutable configuration: future backtests must snapshot the
/// membership and buy-window state they ran with instead of referencing this row's current state.
model StockList {
  id           String          @id @default(uuid())
  userId       String
  name         String
  description  String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items        StockListItem[]
  backtestRuns BacktestRun[]
  monitors     Monitor[]

  @@index([userId])
}

/// Membership of one canonical `Security` in one list. The catalog is the identity authority:
/// membership never stores a free-text symbol. `onDelete: Restrict` is deliberate — catalog rows
/// are never product-deleted (sync only deactivates), and user-owned list data must not silently
/// vanish through a catalog mutation.
model StockListItem {
  id            String               @id @default(uuid())
  stockListId   String
  securityId    String
  buyWindowMode BuyWindowMode        @default(FULL)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  stockList     StockList            @relation(fields: [stockListId], references: [id], onDelete: Cascade)
  security      Security             @relation(fields: [securityId], references: [id], onDelete: Restrict)
  buyWindows    StockListBuyWindow[]

  @@unique([stockListId, securityId])
  @@index([securityId])
}

/// User-owned strategy identity: the name and description a user renames freely, plus the version
/// history holding the actual BUY / SELL / FINAL EXIT logic. Names are deliberately not unique per
/// user — identity is this row's id, and two strategies may both be called `Value Strategy`.
model Strategy {
  id           String            @id @default(uuid())
  userId       String
  name         String
  description  String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions     StrategyVersion[]
  backtestRuns BacktestRun[]
  monitors     Monitor[]

  @@index([userId])
  @@index([userId, updatedAt])
}

/// One immutable strategy definition. `definition` is written once and never updated: a change
/// appends a new version, so a strategy referenced by a completed backtest can never be altered
/// retroactively. The highest `versionNumber` is the current one, so no pointer column and no
/// circular relation is needed.
///
/// `definition` is the canonical JSON document produced by `normalizeStrategyDefinition` in
/// `@intrinsic/contracts`, carrying its own `schemaVersion`; nothing queries inside it in SQL.
/// `definitionHash` covers that document with row identifiers stripped, so re-keying a row never
/// appends a version while genuine reordering does. See
/// `docs/decisions/strategy-definition-storage.md`.
model StrategyVersion {
  id             String        @id @default(uuid())
  strategyId     String
  versionNumber  Int
  definition     Json
  definitionHash String
  createdAt      DateTime      @default(now())
  strategy       Strategy      @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  backtestRuns   BacktestRun[]

  @@unique([strategyId, versionNumber])
  @@index([strategyId])
}

/// One canonical CUSTOM buy-window range. Writers must persist only the deterministic normalized
/// set produced by `@intrinsic/domain` (sorted, non-overlapping, non-adjacent, at most one
/// open-ended range): rows here are replaced as a complete set, never patched individually.
/// `endDate` null means open-ended; an unrestricted item uses mode FULL with zero rows instead of
/// a null `startDate`.
model StockListBuyWindow {
  id              String        @id @default(uuid())
  stockListItemId String
  startDate       DateTime      @db.Date
  endDate         DateTime?     @db.Date
  item            StockListItem @relation(fields: [stockListItemId], references: [id], onDelete: Cascade)

  @@unique([stockListItemId, startDate])
}

model SecurityProfile {
  securityId     String   @id
  description    String?
  website        String?
  logoUrl        String?
  ceo            String?
  employees      Int?
  addressStreet  String?
  addressCity    String?
  addressState   String?
  postalCode     String?
  addressCountry String?
  updatedAt      DateTime @updatedAt
  security       Security @relation(fields: [securityId], references: [id], onDelete: Cascade)
}

model FinancialStatement {
  id                   String                 @id @default(uuid())
  securityId           String
  statementType        FinancialStatementType
  fiscalDate           DateTime               @db.Date
  fiscalYear           Int
  period               FinancialPeriod
  reportedCurrency     String
  filingDate           DateTime               @db.Date
  availableFromDate    DateTime               @db.Date
  providerAcceptedDate String?
  contentHash          String
  observedAt           DateTime               @default(now())
  values               Json
  security             Security               @relation(fields: [securityId], references: [id], onDelete: Cascade)

  @@unique([securityId, statementType, fiscalDate, period, filingDate, contentHash])
  @@index([securityId, statementType, period, fiscalDate])
  @@index([securityId, statementType, period, availableFromDate])
}

model StockDatasetState {
  securityId           String
  dataset              StockDataset
  variant              String       @default("")
  earliestDate         DateTime?    @db.Date
  latestDate           DateTime?    @db.Date
  lastSuccessfulSyncAt DateTime?
  security             Security     @relation(fields: [securityId], references: [id], onDelete: Cascade)

  @@id([securityId, dataset, variant])
}

model StockDatasetCoverage {
  id                   String       @id @default(uuid())
  securityId           String
  dataset              StockDataset
  variant              String       @default("")
  fromDate             DateTime     @db.Date
  toDate               DateTime     @db.Date
  lastSuccessfulSyncAt DateTime
  security             Security     @relation(fields: [securityId], references: [id], onDelete: Cascade)

  @@unique([securityId, dataset, variant, fromDate, toDate], map: "StockDatasetCoverage_range_key")
  @@index([securityId, dataset, variant, fromDate, toDate], map: "StockDatasetCoverage_lookup_idx")
}

model DailyPrice {
  securityId String
  date       DateTime @db.Date
  open       Decimal  @db.Decimal(20, 8)
  high       Decimal  @db.Decimal(20, 8)
  low        Decimal  @db.Decimal(20, 8)
  close      Decimal  @db.Decimal(20, 8)
  volume     BigInt
  vwap       Decimal? @db.Decimal(20, 8)
  security   Security @relation(fields: [securityId], references: [id], onDelete: Cascade)

  /// The composite primary key already provides the securityId + date-range B-tree access path.
  @@id([securityId, date])
}

model WeeklyPrice {
  securityId    String
  weekStartDate DateTime @db.Date
  weekEndDate   DateTime @db.Date
  eligibleDate  DateTime @db.Date
  open          Decimal  @db.Decimal(20, 8)
  high          Decimal  @db.Decimal(20, 8)
  low           Decimal  @db.Decimal(20, 8)
  close         Decimal  @db.Decimal(20, 8)
  volume        BigInt
  security      Security @relation(fields: [securityId], references: [id], onDelete: Cascade)

  @@id([securityId, weekStartDate])
  @@index([securityId, eligibleDate])
}

/// Unified daily materialized derived state.
///
/// Exactly one row per security per trading day represents the CURRENT methodology. Historical
/// methodology versions never coexist here: a methodology change rebuilds/replaces the affected
/// rows. Never add a calculation-version column or fold one into the primary key.
///
/// The composite primary key (securityId, date) is the B-tree access path for the only historical
/// access pattern: securityId + date range, ascending. Do not add a redundant (securityId, date)
/// secondary index.
///
/// Derived values whose source changes less frequently than daily (completed-week weekly
/// indicators, fundamentals-driven intrinsic values and blends) are intentionally repeated on each
/// subsequent trading day until a newer eligible value replaces them. A value stays NULL until it
/// first becomes point-in-time eligible; it is never fabricated or back-filled earlier.
model DailyDerivedState {
  securityId               String
  date                     DateTime  @db.Date
  sma20d                   Decimal?  @db.Decimal(20, 8)
  sma50d                   Decimal?  @db.Decimal(20, 8)
  sma100d                  Decimal?  @db.Decimal(20, 8)
  sma200d                  Decimal?  @db.Decimal(20, 8)
  ema20d                   Decimal?  @db.Decimal(20, 8)
  ema50d                   Decimal?  @db.Decimal(20, 8)
  ema200d                  Decimal?  @db.Decimal(20, 8)
  /// Start date of the completed weekly period whose carried-forward weekly indicators are
  /// effective on this trading day. It is set as soon as one completed week exists, which is
  /// earlier than the first week any weekly average has warmed up over, so a present week start
  /// with NULL weekly values means "not warmed up yet", never zero.
  weeklySourceWeekStart    DateTime? @db.Date
  /// Weekly moving averages of the completed week identified by `weeklySourceWeekStart`,
  /// calculated from weekly closes aggregated out of `DailyPrice` and carried forward onto every
  /// trading day until a newer completed week becomes eligible. There is no weekly-cadence
  /// indicator table: the unified daily row is the only materialized representation. The
  /// in-progress week never appears here.
  sma20w                   Decimal?  @db.Decimal(20, 8)
  sma50w                   Decimal?  @db.Decimal(20, 8)
  sma100w                  Decimal?  @db.Decimal(20, 8)
  sma200w                  Decimal?  @db.Decimal(20, 8)
  ema20w                   Decimal?  @db.Decimal(20, 8)
  ema50w                   Decimal?  @db.Decimal(20, 8)
  ema200w                  Decimal?  @db.Decimal(20, 8)
  /// Daily Wilder RSI oscillators over the same canonical daily closes as the daily moving
  /// averages. Unitless values in [0, 100]; NULL until the period's warm-up of period + 1 closes
  /// is complete — a warm-up gap is never written as zero. One shared Wilder methodology serves
  /// all three periods.
  rsi7d                    Decimal?  @db.Decimal(20, 8)
  rsi14d                   Decimal?  @db.Decimal(20, 8)
  rsi21d                   Decimal?  @db.Decimal(20, 8)
  dcfFcff                  Decimal?  @db.Decimal(20, 8)
  residualIncome           Decimal?  @db.Decimal(20, 8)
  ddm                      Decimal?  @db.Decimal(20, 8)
  graham                   Decimal?  @db.Decimal(20, 8)
  blendBalanced            Decimal?  @db.Decimal(20, 8)
  blendConservative        Decimal?  @db.Decimal(20, 8)
  blendDividend            Decimal?  @db.Decimal(20, 8)
  /// Point-in-time provenance is per intrinsic-value model: each model may consume a different
  /// financial-statement family/revision, so its inputs can become public at a different instant.
  /// Each column is the latest publication/availability instant among the inputs actually used by
  /// that model. No-look-ahead audit fields; never later than end of `date`. A model value is only
  /// readable together with its own provenance, and reads filter each model independently.
  ///
  /// Blend provenance is never stored: it is derived as the maximum provenance of the models that
  /// compose the blend, and the blend is unavailable if any required component is missing.
  dcfFcffSourceAsOf        DateTime?
  residualIncomeSourceAsOf DateTime?
  ddmSourceAsOf            DateTime?
  grahamSourceAsOf         DateTime?
  intrinsicCurrency        String?
  security                 Security  @relation(fields: [securityId], references: [id], onDelete: Cascade)

  @@id([securityId, date])
}

// ---------------------------------------------------------------------------
// Benchmark: product identity + market data, deliberately separate from Security
// ---------------------------------------------------------------------------

/// How a benchmark's market data is obtained. V1 ships one kind; the enum exists so a future
/// index-backed or composite benchmark is an added member rather than a reinterpretation of
/// existing rows.
enum BenchmarkSourceKind {
  FMP_SYMBOL
}

/// Datasets a benchmark materializes. Deliberately separate from `StockDataset`: a benchmark has
/// no fundamentals, no derived technicals and no intrinsic values, and must never acquire them
/// merely because it shares a provider with stocks.
enum BenchmarkDataset {
  DAILY_PRICE
}

/// A system-owned comparison series. A benchmark is **not** a portfolio `Security`: it is never
/// bought, never consumes cash or a position slot, and carries no derived series. Its identity is
/// snapshotted into every `BacktestRun`, so replacing the data source behind a code (SPY today,
/// a direct index tomorrow) can never reinterpret a completed run.
/// Product identity a user selects. Deliberately carries nothing that decides what the numbers
/// are: source, provider identifier, currency and methodology live on `BenchmarkSeries`, because
/// changing any of them produces a different series rather than a corrected one.
model Benchmark {
  id           String            @id @default(uuid())
  /// Stable product code snapshotted by runs, e.g. `SP500`.
  code         String            @unique
  name         String
  description  String?
  isActive     Boolean           @default(true)
  displayOrder Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  series       BenchmarkSeries[]
  backtestRuns BacktestRun[]

  @@index([isActive, displayOrder])
}

/// One immutable definition of a benchmark's series, and the identity its market data is stored
/// under. Reconciliation never updates a row here: a changed definition appends a new version, so
/// bars fetched for v1 can never be reinterpreted as v2 and a submitted run pins the exact version
/// it executes against. Idempotence comes from comparing against the *current* version rather than
/// from a unique key over the definition, which would make returning to a previous source
/// impossible — a revert is a new version, and its data is fetched fresh under it.
model BenchmarkSeries {
  id                    String                     @id @default(uuid())
  benchmarkId           String
  /// 1-based, ascending. The highest version of a benchmark is its current definition.
  version               Int
  sourceKind            BenchmarkSourceKind
  /// Provider identifier for `FMP_SYMBOL` benchmarks, e.g. `SPY`.
  providerSymbol        String
  currency              String
  /// Revision of what this series *means*. Bumping it makes a new run incomparable to an older one
  /// on purpose; the run snapshot records the version it executed under.
  methodologyVersion    Int                        @default(1)
  createdAt             DateTime                   @default(now())
  benchmark             Benchmark                  @relation(fields: [benchmarkId], references: [id], onDelete: Cascade)
  dailyPrices           BenchmarkDailyPrice[]
  datasetStates         BenchmarkDatasetState[]
  datasetCoverage       BenchmarkDatasetCoverage[]
  comparisonRuns        BacktestRun[]              @relation("BacktestRunComparisonSeries")
  executionCalendarRuns BacktestRun[]              @relation("BacktestRunExecutionCalendarSeries")

  @@unique([benchmarkId, version])
}

/// Canonical daily bar of a benchmark series, stored separately from `DailyPrice` so benchmark
/// data can never be mistaken for a tradable security's price history. Keyed by the immutable
/// series, never by the mutable product row.
model BenchmarkDailyPrice {
  seriesId String
  date     DateTime        @db.Date
  open     Decimal         @db.Decimal(20, 8)
  high     Decimal         @db.Decimal(20, 8)
  low      Decimal         @db.Decimal(20, 8)
  close    Decimal         @db.Decimal(20, 8)
  volume   BigInt
  series   BenchmarkSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@id([seriesId, date])
}

/// Watermark of the benchmark dataset. Same meaning as `StockDatasetState`, keyed by series.
model BenchmarkDatasetState {
  seriesId             String
  dataset              BenchmarkDataset
  variant              String           @default("")
  earliestDate         DateTime?        @db.Date
  latestDate           DateTime?        @db.Date
  lastSuccessfulSyncAt DateTime?
  series               BenchmarkSeries  @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@id([seriesId, dataset, variant])
}

/// Exact successful coverage interval. Same contract as `StockDatasetCoverage`: the provider was
/// asked for every date in the interval with complete (paginated) requests and every returned row
/// is persisted, under the recorded variant.
model BenchmarkDatasetCoverage {
  id                   String           @id @default(uuid())
  seriesId             String
  dataset              BenchmarkDataset
  variant              String           @default("")
  fromDate             DateTime         @db.Date
  toDate               DateTime         @db.Date
  lastSuccessfulSyncAt DateTime
  series               BenchmarkSeries  @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@unique([seriesId, dataset, variant, fromDate, toDate], map: "BenchmarkDatasetCoverage_range_key")
  @@index([seriesId, dataset, variant, fromDate, toDate], map: "BenchmarkDatasetCoverage_lookup_idx")
}

// ---------------------------------------------------------------------------
// Backtest runs, durable jobs, progress and results
// ---------------------------------------------------------------------------

enum BacktestRunStatus {
  QUEUED
  PREPARING_DATA
  RUNNING
  FINALIZING
  COMPLETED
  FAILED
}

enum BacktestJobStatus {
  QUEUED
  CLAIMED
  COMPLETED
  FAILED
}

enum BacktestTradeAction {
  BUY
  SELL
  FINAL_EXIT
}

/// One immutable execution of a backtest configuration.
///
/// `snapshot` is the reproducibility authority: strategy identity and normalized definition,
/// resolved securities with their normalized BUY windows, period, capital, contribution,
/// `maximumPositions` and the derived full-position policy, the benchmark identity/source, and
/// every methodology version. The `strategyId`/`strategyVersionId`/`stockListId` foreign keys are
/// nullable and `onDelete: SetNull` **on purpose**: deleting a strategy or list must never delete
/// or reinterpret a completed run, and nothing in the read path depends on those rows.
model BacktestRun {
  id                        String                 @id @default(uuid())
  userId                    String
  strategyId                String?
  strategyVersionId         String?
  stockListId               String?
  benchmarkId               String
  /// The exact immutable series this run compares against. Pinned at submission so a later catalog
  /// change can never reinterpret a queued or completed run.
  benchmarkSeriesId         String
  /// The immutable series whose trading days are this run's execution calendar. A system input,
  /// never the user's comparison choice — see `EXECUTION_CALENDAR_REFERENCE_CODE`. Required: it
  /// decides which dates are simulated and when contributions land, so a run that could not pin it
  /// is never created and a run that cannot read it fails rather than simulating other dates.
  executionCalendarSeriesId String
  status                    BacktestRunStatus      @default(QUEUED)
  /// Denormalized configuration. The snapshot remains authoritative; these columns exist so the
  /// collection page can sort and filter without opening a JSON document.
  startDate                 DateTime               @db.Date
  endDate                   DateTime               @db.Date
  initialCapital            Decimal                @db.Decimal(20, 2)
  monthlyContribution       Decimal                @db.Decimal(20, 2)
  maximumPositions          Int
  strategyName              String
  stockListName             String
  securityCount             Int
  snapshot                  Json
  /// SHA-256 of `canonicalBacktestSnapshotDocument(snapshot)` from `@intrinsic/contracts`: the
  /// document with `submittedAt` removed and object keys sorted. Excluding the timestamp makes the
  /// digest an identity of *inputs* — two runs with the same hash executed the same configuration
  /// under the same methodology versions — and sorting the keys keeps it verifiable against this
  /// `JSONB` column, which does not preserve key order.
  snapshotHash              String
  queuedAt                  DateTime               @default(now())
  startedAt                 DateTime?
  completedAt               DateTime?
  /// Stable machine-readable failure code; `failureMessage` is the sanitized user-facing text.
  failureCode               String?
  failureMessage            String?
  /// Which execution phase failed, as a product-safe label. It is the first thing a user needs in
  /// order to act — "preparing data" and "running" mean very different things — so it is a column
  /// rather than a field of `failureDetail`, which never crosses the HTTP boundary.
  failurePhase              String?
  /// Developer diagnostics. Never exposed by any API contract.
  failureDetail             Json?
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt
  user                      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  strategy                  Strategy?              @relation(fields: [strategyId], references: [id], onDelete: SetNull)
  strategyVersion           StrategyVersion?       @relation(fields: [strategyVersionId], references: [id], onDelete: SetNull)
  stockList                 StockList?             @relation(fields: [stockListId], references: [id], onDelete: SetNull)
  benchmark                 Benchmark              @relation(fields: [benchmarkId], references: [id], onDelete: Restrict)
  benchmarkSeries           BenchmarkSeries        @relation("BacktestRunComparisonSeries", fields: [benchmarkSeriesId], references: [id], onDelete: Restrict)
  executionCalendarSeries   BenchmarkSeries        @relation("BacktestRunExecutionCalendarSeries", fields: [executionCalendarSeriesId], references: [id], onDelete: Restrict)
  job                       BacktestJob?
  progress                  BacktestRunProgress?
  milestones                BacktestRunMilestone[]
  summary                   BacktestRunSummary?
  trades                    BacktestTrade[]
  equityPoints              BacktestDailyEquity[]
  positions                 BacktestPosition[]

  @@index([userId, queuedAt])
  @@index([userId, status])
  /// Restrict-on-delete has to check this column before any benchmark series can be removed.
  @@index([executionCalendarSeriesId])
}

/// The durable queue. One row per run, created in the same transaction as the run, so the queue
/// and the execution record are the same source of truth and cannot diverge. A worker claims with
/// `SELECT ... FOR UPDATE SKIP LOCKED` and holds the row through a renewable lease; an expired
/// lease is reclaimable, which is what makes a crashed worker self-healing.
model BacktestJob {
  id             String            @id @default(uuid())
  runId          String            @unique
  status         BacktestJobStatus @default(QUEUED)
  /// Earliest instant this job may be claimed. Retries push it forward.
  availableAt    DateTime          @default(now())
  attempts       Int               @default(0)
  maxAttempts    Int               @default(3)
  claimedBy      String?
  claimedAt      DateTime?
  leaseExpiresAt DateTime?
  heartbeatAt    DateTime?
  lastError      String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  run            BacktestRun       @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([status, availableAt])
  @@index([status, leaseExpiresAt])
}

/// Live execution progress and the latest checkpoint snapshot.
///
/// Separate from `BacktestRun` because these columns are written repeatedly while the run
/// executes, whereas the run row — including its immutable submission snapshot — is not. The
/// snapshot here is a bounded, downsampled projection for the running UI; it is never the durable
/// result, which lands in the summary/equity/trade tables when execution completes.
model BacktestRunProgress {
  runId            String      @id
  percent          Int         @default(0)
  message          String?
  simulatedThrough DateTime?   @db.Date
  /// Monotonic checkpoint counter. A poller can tell a newer snapshot from an older one without
  /// comparing clocks across processes.
  sequence         Int         @default(0)
  snapshot         Json?
  updatedAt        DateTime    @updatedAt
  run              BacktestRun @relation(fields: [runId], references: [id], onDelete: Cascade)
}

/// One completed calendar year of a run, persisted as it happens.
///
/// The latest live snapshot is a *replacement*: each checkpoint overwrites the previous one, so a
/// browser that polls more slowly than the worker simulates sees only wherever the run had got to.
/// For a thirty-year run the progression itself is the thing a user follows, so each completed year
/// is also written here, ordered and never overwritten. A V1 run is capped at thirty years, which
/// makes the whole progression at most about thirty small rows.
///
/// Deliberately carries no curve: the curve belongs to the live snapshot and to the durable
/// `BacktestDailyEquity` rows, and storing a downsampled copy of it thirty times would duplicate
/// the run's daily history for no gain.
model BacktestRunMilestone {
  runId                  String
  /// 1-based order of completion. A client keeps the highest it has consumed.
  sequence               Int
  /// The calendar year this milestone completes, as `YYYY`.
  year                   String
  simulatedThrough       DateTime    @db.Date
  percent                Int
  completedDays          Int
  totalDays              Int
  cash                   Decimal     @db.Decimal(20, 2)
  totalValue             Decimal     @db.Decimal(20, 2)
  investedCapital        Decimal     @db.Decimal(20, 2)
  portfolioReturnPercent Decimal     @db.Decimal(20, 8)
  benchmarkReturnPercent Decimal?    @db.Decimal(20, 8)
  alphaPercent           Decimal?    @db.Decimal(20, 8)
  maxDrawdownPercent     Decimal     @db.Decimal(20, 8)
  tradeCount             Int
  openPositions          Int
  createdAt              DateTime    @default(now())
  run                    BacktestRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@id([runId, sequence])
  /// A year is completed once. The constraint is what makes a re-delivered checkpoint idempotent:
  /// the insert is skipped rather than appended under a fresh sequence.
  @@unique([runId, year])
}

/// One executed order. `sequence` is the deterministic execution order inside the run: two runs of
/// the same snapshot produce identical sequences.
model BacktestTrade {
  id                 String              @id @default(uuid())
  runId              String
  sequence           Int
  date               DateTime            @db.Date
  securityId         String
  /// Denormalized identity so results render without joining the mutable catalog.
  symbol             String
  name               String
  action             BacktestTradeAction
  /// Strategy level that produced the order; null for FINAL EXIT, which has no percentage.
  levelId            String?
  levelPercentage    Int?
  shares             Decimal             @db.Decimal(28, 10)
  price              Decimal             @db.Decimal(20, 8)
  amount             Decimal             @db.Decimal(24, 6)
  fees               Decimal             @db.Decimal(24, 6)
  realizedPnl        Decimal?            @db.Decimal(24, 6)
  realizedPnlPercent Decimal?            @db.Decimal(20, 8)
  cashAfter          Decimal             @db.Decimal(24, 6)
  sharesAfter        Decimal             @db.Decimal(28, 10)
  averageCostAfter   Decimal?            @db.Decimal(20, 8)
  run                BacktestRun         @relation(fields: [runId], references: [id], onDelete: Cascade)
  security           Security            @relation(fields: [securityId], references: [id], onDelete: Restrict)

  @@unique([runId, sequence])
  @@index([runId, date])
}

/// One portfolio valuation per simulated trading date.
///
/// It carries two readings of the same day, and they answer different questions.
///
/// `returnIndex` and `benchmarkIndex` are growth indices based at 1.0 on the first simulated date,
/// which is what makes portfolio and benchmark percentage growth directly comparable. The
/// portfolio index is time-weighted, so a monthly contribution raises value without inventing
/// return. `benchmarkIndex` is null on a date the benchmark has no value at or before — never
/// fabricated. Every existing summary metric — return, alpha, CAGR, both drawdowns — is built on
/// these and is unchanged.
///
/// `totalValue`, `benchmarkValue` and `cashBaselineValue` are the three absolute comparison
/// scenarios the chart shows, all funded by the same external cash flows on the same dates:
/// the Strategy portfolio, a passive benchmark portfolio that buys fractional shares with each
/// contribution, and capital that was never invested. See `comparisonScenarios` in the run's
/// snapshotted methodology.
model BacktestDailyEquity {
  runId             String
  date              DateTime    @db.Date
  cash              Decimal     @db.Decimal(24, 6)
  positionsValue    Decimal     @db.Decimal(24, 6)
  totalValue        Decimal     @db.Decimal(24, 6)
  investedCapital   Decimal     @db.Decimal(24, 6)
  returnIndex       Decimal     @db.Decimal(20, 10)
  benchmarkIndex    Decimal?    @db.Decimal(20, 10)
  /// Absolute value of the funded benchmark scenario. Null on a date the benchmark cannot be
  /// priced, and null for every run completed before the scenario existed — it is not derivable
  /// from `benchmarkIndex` once the run has contributions, so it is never backfilled.
  benchmarkValue    Decimal?    @db.Decimal(24, 6)
  /// Absolute value of the `Cash` scenario: initial capital plus contributions to date, earning
  /// nothing under `zero-interest@1`. Deliberately not `cash`, which is the Strategy's own
  /// uninvested balance.
  cashBaselineValue Decimal     @db.Decimal(24, 6)
  openPositions     Int
  run               BacktestRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@id([runId, date])
}

/// A position still open on the final simulated date.
model BacktestPosition {
  id                   String      @id @default(uuid())
  runId                String
  securityId           String
  symbol               String
  name                 String
  openedDate           DateTime    @db.Date
  shares               Decimal     @db.Decimal(28, 10)
  averageCost          Decimal     @db.Decimal(20, 8)
  lastPrice            Decimal     @db.Decimal(20, 8)
  lastPriceDate        DateTime    @db.Date
  marketValue          Decimal     @db.Decimal(24, 6)
  unrealizedPnl        Decimal     @db.Decimal(24, 6)
  unrealizedPnlPercent Decimal     @db.Decimal(20, 8)
  allocationPercent    Decimal     @db.Decimal(20, 8)
  run                  BacktestRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  security             Security    @relation(fields: [securityId], references: [id], onDelete: Restrict)

  @@unique([runId, securityId])
}

/// Aggregate result metrics, one row per completed run, sufficient to render the completed detail
/// page without replaying the simulation.
model BacktestRunSummary {
  runId                       String      @id
  firstSimulatedDate          DateTime    @db.Date
  lastSimulatedDate           DateTime    @db.Date
  tradingDays                 Int
  investedCapital             Decimal     @db.Decimal(24, 6)
  finalCash                   Decimal     @db.Decimal(24, 6)
  finalPositionsValue         Decimal     @db.Decimal(24, 6)
  finalValue                  Decimal     @db.Decimal(24, 6)
  netProfit                   Decimal     @db.Decimal(24, 6)
  portfolioReturnPercent      Decimal     @db.Decimal(20, 8)
  benchmarkReturnPercent      Decimal?    @db.Decimal(20, 8)
  alphaPercent                Decimal?    @db.Decimal(20, 8)
  portfolioCagrPercent        Decimal?    @db.Decimal(20, 8)
  maxDrawdownPercent          Decimal     @db.Decimal(20, 8)
  benchmarkMaxDrawdownPercent Decimal?    @db.Decimal(20, 8)
  realizedPnl                 Decimal     @db.Decimal(24, 6)
  unrealizedPnl               Decimal     @db.Decimal(24, 6)
  totalTrades                 Int
  buyTrades                   Int
  sellTrades                  Int
  finalExitTrades             Int
  winningTrades               Int
  losingTrades                Int
  openPositions               Int
  run                         BacktestRun @relation(fields: [runId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Monitors
// ---------------------------------------------------------------------------

/// Whether one Monitor evaluation produced a match, a definitive non-match, or could not be
/// decided. It is the durable projection of `Evaluability` from `@intrinsic/strategy`, named in
/// product vocabulary because it is what a Signal's history is read as.
///
/// `NOT_EVALUABLE` is deliberately a first-class value rather than an absence: a provider failure,
/// a warm-up gap or a withheld point-in-time input must be recorded as "not decided", never
/// collapsed into `NOT_MATCHED`, which would look like the match had genuinely ended.
enum MonitorEvaluationOutcome {
  MATCHED
  NOT_MATCHED
  NOT_EVALUABLE
}

/// The two outcomes a transition may be decided from. `NOT_EVALUABLE` is absent on purpose: it
/// never overwrites the last decided state, so the column can only ever hold a decided one.
enum MonitorEvaluableResult {
  MATCHED
  NOT_MATCHED
}

/// Which Strategy level produced a Signal. Mirrors `StrategyLevelKind` in `@intrinsic/contracts`;
/// `BacktestTradeAction` is deliberately not reused — that enum describes an executed order.
enum MonitorLevelKind {
  BUY
  SELL
  FINAL_EXIT
}

/// One user-owned Monitor: a Strategy evaluated against current market data over a Stock List.
///
/// It references the `Strategy` rather than a pinned `StrategyVersion`, because a Monitor is live:
/// editing the Strategy must change what is being watched. Durable state is scoped to the canonical
/// logic of its own level instead — see `MonitorSignalState.signalFingerprint` — so an edit resets
/// only the levels whose semantics actually changed. A `MonitorSignal` records the version it was
/// decided under, as history.
///
/// The user controls `name`, `enabled`, and which `strategyId` and `stockListId` are referenced.
/// Monitoring cadence is an application decision and is deliberately not a column —
/// `ai/product/monitors.md` forbids exposing it.
///
/// Changing `strategyId` or `stockListId` is a **rebind**, not an edit of what they contain: it
/// crosses a configuration boundary, so `MonitorSignalState` is discarded, active Signals are
/// resolved, `lastScanAt` is cleared and `configVersion` is incremented. Editing the referenced
/// Strategy's rules or the List's membership is the live path and touches none of that.
///
/// `strategyId` and `stockListId` are `onDelete: Restrict`. A Monitor is not a derived view of its
/// Strategy and List: it owns Signal history, which is a record of what was observed and must not
/// disappear because a referenced row was deleted. Cascading would make deleting a Strategy a
/// silent, unannounced deletion of every Monitor watching with it and every Signal they ever
/// produced. The user deletes the Monitor first, explicitly. It cascades from `User` like every
/// other user-owned row, because deleting the account is the one case where all of it should go.
model Monitor {
  id          String    @id @default(uuid())
  userId      String
  strategyId  String
  stockListId String
  name        String
  enabled     Boolean   @default(true)
  /// Last cycle instant this Monitor was actually evaluated in, for observability and the UI's
  /// "last checked" line. It is never an input to trigger semantics.
  ///
  /// Cleared when the Monitor is rebound to a different Strategy or Stock List: the configuration
  /// it now names has not been checked, and reporting the previous one's scan time would claim
  /// otherwise.
  lastScanAt  DateTime?
  /// Which `(strategyId, stockListId)` binding this Monitor is on. Incremented **only** when one of
  /// them is rebound — never by a rename or an enable/disable, which change nothing a running cycle
  /// evaluated.
  ///
  /// It is the fence between a cycle and a rebind. A cycle reads the binding it loaded and every
  /// durable write it makes is conditioned on this still being that value, so an evaluation of the
  /// replaced configuration cannot land in the new one after the fact. A monotonic counter rather
  /// than a comparison of the two ids, because rebinding away and back would otherwise present the
  /// same pair to an in-flight cycle whose state had already been discarded.
  configVersion Int     @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  strategy  Strategy             @relation(fields: [strategyId], references: [id], onDelete: Restrict)
  stockList StockList            @relation(fields: [stockListId], references: [id], onDelete: Restrict)
  states    MonitorSignalState[]
  signals   MonitorSignal[]

  @@index([userId])
  @@index([userId, updatedAt])
  /// The scan cycle's own query: every enabled Monitor, cheaply.
  @@index([enabled])
}

/// The durable transition state of one `(Monitor, Security, Strategy level)`.
///
/// This is the minimum state that makes trigger and condition semantics survive a process restart
/// or a cache flush, and it is deliberately not a cache of anything: `ai/architecture/monitor-engine.md`
/// requires ephemeral memory never to be the sole source of it.
///
/// `lastEvaluableResult` is the latch. A `NOT_EVALUABLE` cycle records itself in `lastOutcome` for
/// observability but leaves the latch alone, so a provider outage can neither end an active match
/// nor re-emit it on recovery.
///
/// `stateVersion` is an optimistic guard. The transition is applied with an `updateMany` filtered
/// on the version it was read at, so two processes whose leases briefly overlap cannot both emit a
/// Signal for one transition: the loser matches no row and writes nothing.
model MonitorSignalState {
  id                String           @id @default(uuid())
  monitorId         String
  securityId        String
  /// The canonical level id inside the Strategy definition document.
  levelId           String
  levelKind         MonitorLevelKind
  /// Canonical fingerprint of the Signal this state belongs to, from `strategySignalFingerprint`
  /// in `@intrinsic/contracts`.
  ///
  /// The invalidation key is the **level's own logic**, not the Strategy version: editing one
  /// condition appends a new version, and keying on the version would discard the latched state of
  /// every other, unchanged level with it — re-emitting a Signal on each of them for a match that
  /// never stopped. A level whose logic did change no longer describes what this state latched, so
  /// its state is reset.
  signalFingerprint String

  lastEvaluableResult MonitorEvaluableResult
  /// The provisional observation date the latched result was decided on.
  lastEvaluableDate   DateTime               @db.Date
  lastEvaluableAt     DateTime

  /// The most recent outcome including `NOT_EVALUABLE`. Observability and UI only.
  lastOutcome   MonitorEvaluationOutcome
  lastOutcomeAt DateTime

  /// The Signal currently active for this state, or null when nothing is matched. Unique, so one
  /// state can never point at two live Signals.
  activeSignalId String? @unique

  /// Observation date the most recent Signal was emitted on, for a Signal carrying a Trigger.
  ///
  /// A Trigger is an *event on a date*: the canonical daily series has `crosses above` TRUE on
  /// exactly one date, however many times it is evaluated that day. The provisional observation
  /// moves intraday while its `t - 1` stays fixed at the last closed day, so a price that crosses,
  /// dips back and crosses again satisfies the predicate twice within one date — and without this
  /// column each would look like a fresh transition and emit a second Signal for one crossing.
  /// A Condition has no such column on purpose: it describes a state, and a state that genuinely
  /// ends and begins again is two matches.
  lastTriggerSignalDate DateTime? @db.Date

  stateVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  monitor      Monitor        @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  security     Security       @relation(fields: [securityId], references: [id], onDelete: Restrict)
  activeSignal MonitorSignal? @relation("MonitorSignalStateActiveSignal", fields: [activeSignalId], references: [id], onDelete: SetNull)

  /// One state per level per security per monitor. Named explicitly: the generated name would
  /// exceed PostgreSQL's 63-character identifier limit.
  @@unique([monitorId, securityId, levelId], map: "MonitorSignalState_identity_key")
  @@index([monitorId])
  @@index([securityId])
}

/// One Signal: a symbol matched one of the Strategy's canonical levels under a Monitor evaluation.
///
/// A Signal is created on the `NOT_MATCHED -> MATCHED` edge and only there, so a condition that
/// stays true across scans keeps one Signal instead of producing a new one each cycle.
///
/// The two kinds have deliberately different lifetimes, because a condition is a state and a trigger
/// is an event on a date (`ai/product/monitors.md`). A condition's Signal is resolved when its state
/// ends. A trigger's is emitted at most once per `observationDate` — the provisional observation
/// moves during a session while its `t - 1` stays fixed, so a price that crosses, moves back and
/// crosses again within one date is still one crossing — and it is closed when a later session is
/// observed rather than by an intraday tick back across the line. The row is never deleted.
///
/// `hasTrigger` is explanation metadata, not a second product concept: `ai/product/monitors.md`
/// requires condition-only matches and trigger events to remain the same user-facing Signal.
model MonitorSignal {
  id                String           @id @default(uuid())
  monitorId         String
  securityId        String
  levelId           String
  levelKind         MonitorLevelKind
  /// The Strategy version whose definition produced this Signal. A Signal is a historical record,
  /// so it keeps the version it was decided under even after the Strategy is edited.
  strategyVersionId String
  /// Whether the matched Strategy signal carried a Trigger. Both remain Signals.
  hasTrigger        Boolean

  /// The provisional observation this Signal was decided on: persisted closed history plus the
  /// current live price. A Monitor evaluation requires one, so there is no second source to record.
  observationDate  DateTime @db.Date
  observationPrice Decimal  @db.Decimal(20, 8)

  detectedAt DateTime  @default(now())
  /// When the matched state stopped being active. Null while the match continues.
  resolvedAt DateTime?

  monitor   Monitor             @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  security  Security            @relation(fields: [securityId], references: [id], onDelete: Restrict)
  /// Back-reference of `MonitorSignalState.activeSignalId`; at most one state points here.
  activeFor MonitorSignalState? @relation("MonitorSignalStateActiveSignal")

  @@index([monitorId, detectedAt])
  @@index([securityId])
  /// The "currently active Signals" read: unresolved rows, newest first.
  @@index([monitorId, resolvedAt, detectedAt])
}

/// The durable Monitor scan schedule: exactly one row, claimed like a job.
///
/// Cadence is an application decision, so nothing user-facing points here. A worker claims the row
/// with `SELECT ... FOR UPDATE SKIP LOCKED` once `dueAt` has passed, holds a renewable lease while
/// it runs the cycle, then sets the next `dueAt` and releases. A crashed worker's lease expires and
/// another process reclaims it, which is what makes scanning self-healing without a queue library
/// and without Redis — matching `BacktestJob`, whose protocol this follows deliberately.
model MonitorScanSchedule {
  /// Always `MONITOR_SCAN_SCHEDULE_ID`. A singleton row is what serializes the cycle.
  id                  String    @id
  /// Earliest instant the next cycle may start.
  dueAt               DateTime  @default(now())
  claimedBy           String?
  claimedAt           DateTime?
  leaseExpiresAt      DateTime?
  heartbeatAt         DateTime?
  /// Monotonic cycle counter, so two cycles are distinguishable in logs without comparing clocks.
  cycleSequence       Int       @default(0)
  lastStartedAt       DateTime?
  lastCompletedAt     DateTime?
  /// Consecutive failed cycles, for backoff and alerting. Reset by a cycle that completes.
  consecutiveFailures Int       @default(0)
  lastError           String?
  updatedAt           DateTime  @updatedAt

  @@index([dueAt])
}

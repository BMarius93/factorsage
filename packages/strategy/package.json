{
  "name": "@intrinsic/strategy",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "pnpm --filter @intrinsic/contracts build && pnpm --filter @intrinsic/domain build && vitest run"
  },
  "dependencies": {
    "@intrinsic/contracts": "workspace:*",
    "@intrinsic/domain": "workspace:*",
    "decimal.js": "10.6.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vitest": "^2.1.9"
  }
}

{
  "name": "@intrinsic/testing",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./personas": {
      "types": "./dist/personas.d.ts",
      "import": "./dist/personas.js",
      "require": "./dist/personas.js",
      "default": "./dist/personas.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "capture:execution-calendar": "tsx scripts/capture-execution-calendar.ts"
  },
  "dependencies": {
    "@intrinsic/config": "workspace:*",
    "@intrinsic/contracts": "workspace:*",
    "@intrinsic/domain": "workspace:*",
    "@intrinsic/strategy": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.0"
  }
}
